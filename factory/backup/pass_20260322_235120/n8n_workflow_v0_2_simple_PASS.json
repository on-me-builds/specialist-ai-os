{
  "name": "Product Factory v0.2 Simple",
  "nodes": [
    {
      "parameters": {},
      "id": "simple-manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const factoryRoot = process.env.FACTORY_ROOT || 'C:/Users/tkym1/OneDrive/ドキュメント/Obsidian Vault/specialist-ai-os';\nconst pythonBin = process.env.PYTHON_BIN || 'python';\nconst inputFile = factoryRoot + '/factory/forms/sheets_row_example.json';\nconst slug = 'n8n_test';\n\nreturn [{ json: { factoryRoot, pythonBin, inputFile, slug } }];"
      },
      "id": "simple-setup",
      "name": "Setup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "const { execSync } = require('child_process');\nconst { factoryRoot, pythonBin, inputFile, slug } = $input.first().json;\nconst cmd = `cd \"${factoryRoot}\" && ${pythonBin} factory/scripts/run_pipeline.py --input \"${inputFile}\" --slug ${slug} --llm`;\nlet stdout = '', stderr = '', exitCode = 0;\ntry {\n  stdout = execSync(cmd, { encoding: 'utf-8', timeout: 300000 });\n} catch (e) {\n  stdout = e.stdout || '';\n  stderr = e.stderr || e.message;\n  exitCode = e.status || 1;\n}\nreturn [{ json: { stdout, stderr, exitCode } }];"
      },
      "id": "simple-run-pipeline",
      "name": "Run Pipeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "id": "check-exit",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "simple-if",
      "name": "PASS or FAIL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s", "name": "status", "value": "PASS", "type": "string" },
            { "id": "m", "name": "message", "value": "={{ '✅ パック生成成功\\n' + $('Run Pipeline').first().json.stdout.split('\\n').slice(-5).join('\\n') }}", "type": "string" }
          ]
        }
      },
      "id": "simple-pass",
      "name": "PASS",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s", "name": "status", "value": "FAIL", "type": "string" },
            { "id": "m", "name": "message", "value": "={{ '❌ パック生成に問題あり\\n' + ($('Run Pipeline').first().json.stderr || $('Run Pipeline').first().json.stdout || '詳細なし').split('\\n').slice(-5).join('\\n') }}", "type": "string" }
          ]
        }
      },
      "id": "simple-fail",
      "name": "FAIL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1130, 400]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Setup", "type": "main", "index": 0 }]]
    },
    "Setup": {
      "main": [[{ "node": "Run Pipeline", "type": "main", "index": 0 }]]
    },
    "Run Pipeline": {
      "main": [[{ "node": "PASS or FAIL?", "type": "main", "index": 0 }]]
    },
    "PASS or FAIL?": {
      "main": [
        [{ "node": "PASS", "type": "main", "index": 0 }],
        [{ "node": "FAIL", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false },
  "pinData": {},
  "tags": [{ "name": "product-factory" }, { "name": "simple" }]
}
